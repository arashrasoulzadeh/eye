# Required application secrets. Replace both values before starting Compose.
ADMIN_KEY=replace-with-a-long-random-admin-key
API_KEY_SALT=replace-with-a-long-random-api-key-salt

# SQLite is the default development storage backend.
DB_DRIVER=sqlite
CORS_ORIGINS=http://localhost:3003

# For PostgreSQL/TimescaleDB, use docker-compose.postgres.yml and set:
# POSTGRES_PASSWORD=replace-with-a-strong-database-password
# ENABLE_POSTGRES_RLS=false

# Optional Redis Streams transport.
# BROKER_URL=redis://redis:6379
# BROKER_STREAM=eye-events
# BROKER_GROUP=eye-consumers
# BROKER_CONSUMER=eye-server
